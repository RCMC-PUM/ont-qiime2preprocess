/*
 * EPICARD ONT 16S preprocessing - configuration
 *
 * Defaults below are overridden by:  -params-file params.yaml
 * Software backend is chosen by profile:  -profile docker   (or conda / singularity)
 */

manifest {
    name            = 'nf-rcmc/ont-16s-preprocess'
    author          = 'dr Michał Kowalski - RCMC PUM'
    description     = 'ONT 16S rRNA preprocessing: BAM->FASTQ->QC->filter->QC->orient->MultiQC'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.0'
    version         = '1.0.0a'
}

// ---------------------------------------------------------------------------
// Default parameters (params.yaml overrides these)
// ---------------------------------------------------------------------------
params {
    // Input
    manifest            = "${projectDir}/metadata/sample-manifest.csv"
    input_dir           = '.'      // relative bam_path values in the manifest are anchored here
    merge_barcode_bams  = false    // true = merge all *.bam in each barcode dir (multi-chunk MinKNOW output)

    // Reference (de-gapped, unaligned SILVA NR99)
    ref_db              = "${projectDir}/misc/ref/SILVA_144_SSURef_NR99_tax_silva_trunc.fasta"

    // Output
    outdir              = 'results'
    publish_mode        = 'copy'

    // Filtering (NanoFilt)
    min_len             = 800
    max_len             = 2200
    qscore              = 15

    // Resources
    threads             = 12       // requested cpus for the multithreaded steps
    max_cpus            = 32       // hard ceiling for cpus
    max_memory          = '128.GB'
    max_time            = '24.h'
}

// ---------------------------------------------------------------------------
// Process resources
// ---------------------------------------------------------------------------
process {

    cpus          = 1
    memory        = { check_max( 4.GB  * task.attempt, 'memory' ) }
    time          = { check_max( 2.h   * task.attempt, 'time'   ) }

    errorStrategy = { task.exitStatus in [104,134,137,139,140,143,247] ? 'retry' : 'finish' }
    maxRetries    = 2

    withName: SAMTOOLS_FASTQ {
        cpus   = { check_max( params.threads, 'cpus' ) }
        memory = { check_max( 16.GB * task.attempt, 'memory' ) }
    }
    withName: 'NANOPLOT_.*' {
        cpus   = 8
        memory = { check_max( 16.GB * task.attempt, 'memory' ) }
    }
    withName: NANOFILT {
        cpus   = 8
        memory = { check_max( 16.GB * task.attempt, 'memory' ) }
    }
    withName: VSEARCH_ORIENT {
        cpus   = 1                                   // orient is single-threaded
        memory = { check_max( 16.GB * task.attempt, 'memory' ) }   // holds the SILVA db in RAM
    }
    withName: MULTIQC {
        cpus   = 16
        memory = { check_max( 16.GB * task.attempt, 'memory' ) }
    }
    withName: WRITE_QIIME_MANIFEST {
        cpus   = 1
        memory = { check_max( 8.GB, 'memory' ) }
    }
}

// ---------------------------------------------------------------------------
// Profiles: pick a software backend
// ---------------------------------------------------------------------------
profiles {

    docker {
        docker.enabled      = true
        docker.runOptions   = '-u $(id -u):$(id -g)'   // outputs owned by you, not root
        conda.enabled       = false
        singularity.enabled = false
    }

    conda {
        conda.enabled       = true
        conda.channels      = ['conda-forge', 'bioconda', 'nanoporetech', 'defaults']
        // conda.useMamba   = true   // uncomment if mamba is available (much faster solves)
        docker.enabled      = false
        singularity.enabled = false
    }

    // For HPC (e.g. Cyfronet Helios), where Docker is usually unavailable.
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
        conda.enabled          = false
    }

    // Example SLURM executor overlay - combine e.g. `-profile singularity,slurm`
    slurm {
        process.executor = 'slurm'
        // process.queue = 'plgrid'      // set your partition
        // process.clusterOptions = '-A <grant_id>'
    }

    test {
        params.max_cpus   = 4
        params.max_memory = '8.GB'
        params.threads    = 4
    }
}

// ---------------------------------------------------------------------------
// Execution reports
// ---------------------------------------------------------------------------
def trace_ts = new java.util.Date().format('yyyyMMdd_HHmmss')
timeline { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/timeline_${trace_ts}.html" }
report   { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/report_${trace_ts}.html"   }
trace    { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/trace_${trace_ts}.txt"     }
dag      { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/dag_${trace_ts}.html"      }

// ---------------------------------------------------------------------------
// check_max: clamp per-process requests to the params.max_* ceilings
// ---------------------------------------------------------------------------
def check_max(obj, type) {
    if (type == 'memory') {
        try {
            def cap = params.max_memory as nextflow.util.MemoryUnit
            def val = (obj instanceof String) ? (obj as nextflow.util.MemoryUnit) : obj
            return val.compareTo(cap) == 1 ? cap : val
        } catch (all) {
            println "WARN: invalid max_memory '${params.max_memory}', using requested ${obj}"
            return obj
        }
    } else if (type == 'time') {
        try {
            def cap = params.max_time as nextflow.util.Duration
            def val = (obj instanceof String) ? (obj as nextflow.util.Duration) : obj
            return val.compareTo(cap) == 1 ? cap : val
        } catch (all) {
            println "WARN: invalid max_time '${params.max_time}', using requested ${obj}"
            return obj
        }
    } else if (type == 'cpus') {
        try {
            return Math.min( obj as int, params.max_cpus as int )
        } catch (all) {
            println "WARN: invalid max_cpus '${params.max_cpus}', using requested ${obj}"
            return obj
        }
    }
    return obj
}
