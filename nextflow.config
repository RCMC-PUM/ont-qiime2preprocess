/*
 * EPICARD ONT 16S preprocessing - configuration
 *
 * Defaults below are overridden by:  -params-file params.yaml
 * Software backend is chosen by profile:  -profile docker   (or conda / singularity)
 */

manifest {
    name            = 'qiime2preprocess'
    author          = 'dr Michał Kowalski | RCMC PUM'
    description     = 'ONT 16S rRNA preprocessing: uBAM->FASTQ->QC->filter->QC->orient->MultiQC'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.0'
    version         = '1.0.0'
}

// Task work directory (override on the command line with -w <dir>)
workDir = "${launchDir}/work"

// Reuse cached task results from previous runs (same as passing -resume)
resume  = true

// ---------------------------------------------------------------------------
// Default parameters (params.yaml overrides these)
// ---------------------------------------------------------------------------
params {
    // Input
    manifest            = "${launchDir}/metadata/sample-manifest.csv"
    input_dir           = '.'      // relative bam_path values in the manifest are anchored here
    merge_barcode_bams  = false    // true = merge all *.bam in each barcode dir (multi-chunk MinKNOW output)

    // Reference (de-gapped, unaligned SILVA NR99)
    ref_db              = "${launchDir}/misc/ref/SILVA_144_SSURef_NR99_tax_silva_trunc.fasta"

    // Output
    outdir              = 'results'
    publish_mode        = 'copy'

    // Filtering (NanoFilt)
    min_len             = 800
    max_len             = 2200
    qscore              = 15

    // Resources
    threads             = 12       // requested cpus for the multithreaded steps
    max_cpus            = 32       // hard ceiling for cpus
    process_cpu_budget  = 32       // cpus shared by the parallel tasks of one process (sets maxForks)
    max_memory          = '128.GB'
    max_time            = '24.h'
}

// ---------------------------------------------------------------------------
// Process resources
// ---------------------------------------------------------------------------
process {

    // Ceilings: every request below is automatically clamped to these.
    // (Replaces the old nf-core check_max() function, which the strict
    //  config parser in Nextflow >=25 no longer allows.)
    resourceLimits = [
        cpus  : params.max_cpus,
        memory: params.max_memory,
        time  : params.max_time
    ]

    cpus          = 1
    memory        = { 4.GB * task.attempt }
    time          = { 2.h  * task.attempt }

    errorStrategy = { task.exitStatus in [104,134,137,139,140,143,247] ? 'retry' : 'finish' }
    maxRetries    = 2

    // 'lenient' hashes input files by path + size only: robust on shared or
    // network filesystems, where inodes and timestamps are unreliable.
    cache         = 'lenient'

    // maxForks = process_cpu_budget / cpus per task, so the parallel tasks of
    // one process use at most process_cpu_budget cpus (e.g. 32 / 6 = 5 tasks).
    withName: SAMTOOLS_FASTQ {
        cpus     = { 6 * task.attempt }
        memory   = { 8.GB * task.attempt }
        maxForks = params.process_cpu_budget.intdiv(6)
    }
    withName: 'NANOPLOT_.*' {
        cpus     = { 6 * task.attempt }
        memory   = { 8.GB * task.attempt }
        maxForks = params.process_cpu_budget.intdiv(6)
    }
    withName: NANOFILT {
        cpus     = { 6 * task.attempt }
        memory   = { 8.GB * task.attempt }
        maxForks = params.process_cpu_budget.intdiv(6)
    }
    withName: VSEARCH_ORIENT {
        cpus     = 1                         // orient is single-threaded
        memory   = { 16.GB * task.attempt }
        maxForks = params.process_cpu_budget
    }
    withName: MULTIQC {
        cpus   = params.threads
        memory = { 4.GB * task.attempt }
    }
    withName: WRITE_QIIME_MANIFEST {
        cpus   = { params.threads * task.attempt }
        memory = { 4.GB * task.attempt }
    }
}

// ---------------------------------------------------------------------------
// Profiles: pick a software backend
// ---------------------------------------------------------------------------
profiles {

    docker {
        docker.enabled      = true
        docker.runOptions   = '-u $(id -u):$(id -g)'   // outputs owned by you, not root
        conda.enabled       = false
        singularity.enabled = false
    }

    conda {
        conda.enabled       = true
        conda.channels      = ['conda-forge', 'bioconda', 'nanoporetech', 'defaults']
        // conda.useMamba   = true   // uncomment if mamba is available (much faster solves)
        docker.enabled      = false
        singularity.enabled = false
    }

    // For HPC (e.g. Cyfronet Helios), where Docker is usually unavailable.
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
        conda.enabled          = false
    }

    // Example SLURM executor overlay - combine e.g. `-profile singularity,slurm`
    slurm {
        process.executor = 'slurm'
        // process.queue = 'plgrid'      // set your partition
        // process.clusterOptions = '-A <grant_id>'
    }

    test {
        params.max_cpus   = 4
        params.max_memory = '8.GB'
        params.threads    = 4
    }
}

// ---------------------------------------------------------------------------
// Execution reports
// ---------------------------------------------------------------------------
timeline { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/timeline.html" }
report   { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/report.html"   }
trace    { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/trace.txt"     }
dag      { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/dag.html"      }
